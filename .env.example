# ============================================================
# Conversational AI Chatbot — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual keys.
# Never commit .env to version control.
# ============================================================

# --- Ollama (Local LLM — Primary Provider) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=15

# --- Groq (Cloud Fallback Provider) ---
ENABLE_GROQ_FALLBACK=true
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant

# --- OpenWeatherMap API ---
OPENWEATHER_API_KEY=your-openweather-api-key-here

# --- Newsdata.io API ---
NEWS_API_KEY=your-newsdata-io-api-key-here

# --- LangSmith Observability ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=conversational-ai-chatbot

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=20
